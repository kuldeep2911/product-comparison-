# ── Database ──────────────────────────────────────────────────────────────────
# Option A (Supabase / Render): single connection string (preferred in production)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Option B (local dev only): individual parts
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=electronics_db

# ── LLM ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=production
SECRET_KEY=change-me-in-production

# Comma-separated list — add your Vercel URL here
CORS_ORIGINS=https://your-app.vercel.app

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=your-64-byte-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30
